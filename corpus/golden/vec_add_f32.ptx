.version 8.7
.target sm_80
.address_size 64
.visible .entry vec_add_f32(
	.param .u64 a,
	.param .u64 b,
	.param .u64 out,
	.param .u32 n
)
{
	.reg .pred %p1;
	.reg .pred %p2;
	.reg .u32 %r1;
	.reg .u32 %r2;
	.reg .u64 %rd1;
	.reg .u64 %rd2;
	.reg .u64 %rd3;
	.reg .u64 %rd4;
	.reg .u64 %rd5;
	.reg .f32 %f1;
	.reg .f32 %f2;
	.reg .f32 %f3;
$L__entry:
	ld.param.u64 %rd1, [a];
	ld.param.u64 %rd2, [b];
	ld.param.u64 %rd3, [out];
	ld.param.u32 %r1, [n];
	mov.u32 %r2, %ctaid.x;
	setp.ge.u32 %p1, %r2, %r1;
	not.pred %p2, %p1;
	@%p2 bra $L__done;
	mul.wide.u32 %rd4, %r2, 4;
	add.u64 %rd5, %rd1, %rd4;
	ld.global.f32 %f1, [%rd5];
	add.u64 %rd5, %rd2, %rd4;
	ld.global.f32 %f2, [%rd5];
	add.f32 %f3, %f1, %f2;
	add.u64 %rd5, %rd3, %rd4;
	st.global.f32 [%rd5], %f3;
	ret;
$L__done:
	ret;
}
