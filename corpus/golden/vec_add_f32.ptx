.version 8.7
.target sm_80
.address_size 64
.visible .entry vec_add_f32(
	.param .u64 a,
	.param .u64 b,
	.param .u64 out,
	.param .u32 n
)
{
	.reg .pred %p1<2>;
	.reg .u32 %r1<2>;
	.reg .u64 %rd1<4>;
	.reg .f32 %f1<3>;
$L__entry:
	ld.param.u64 %rd1, [a];
	ld.param.u64 %rd2, [b];
	ld.param.u64 %rd3, [out];
	ld.param.u32 %r1, [n];
	mov.u32 %r2, %ctaid.x;
	setp.ge.u32 %p1, %r2, %r1;
	not.pred %p2, %p1;
	@%p2 bra $L__done;
	mul.wide.u32 %rd4, %r2, 4;
	ld.global.f32 %f1, [%rd1+%rd4];
	ld.global.f32 %f2, [%rd2+%rd4];
	add.f32 %f3, %f1, %f2;
	st.global.f32 [%rd3+%rd4], %f3;
	ret;
$L__done:
	ret;
}
