.version 8.7
.target sm_80
.address_size 64
.visible .entry saxpy_f32(
	.param .u64 x,
	.param .u64 y,
	.param .u64 out,
	.param .f32 alpha,
	.param .u32 n
)
{
	.reg .pred %p1;
	.reg .pred %p2;
	.reg .u32 %r2;
	.reg .u32 %r3;
	.reg .u64 %rd1;
	.reg .u64 %rd2;
	.reg .u64 %rd3;
	.reg .u64 %rd4;
	.reg .u64 %rd5;
	.reg .f32 %f1;
	.reg .f32 %f2;
	.reg .f32 %f3;
	.reg .f32 %f4;
$L__entry:
	ld.param.u64 %rd1, [x];
	ld.param.u64 %rd2, [y];
	ld.param.u64 %rd3, [out];
	ld.param.f32 %f1, [alpha];
	ld.param.u32 %r2, [n];
	mov.u32 %r3, %ctaid.x;
	setp.ge.u32 %p1, %r3, %r2;
	not.pred %p2, %p1;
	@%p2 bra $L__done;
	mul.wide.u32 %rd4, %r3, 4;
	add.u64 %rd5, %rd1, %rd4;
	ld.global.f32 %f2, [%rd5];
	add.u64 %rd5, %rd2, %rd4;
	ld.global.f32 %f3, [%rd5];
	fma.rn.f32 %f4, %f1, %f2, %f3;
	add.u64 %rd5, %rd3, %rd4;
	st.global.f32 [%rd5], %f4;
	ret;
$L__done:
	ret;
}
